{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hezhijie0327/zjsearch",
  "version": "0.1.0",
  "private": true,
  "license": "Apache 2.0 with Commons Clause v1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath client/zjsearch/.husky || true",
    "audit": "node scripts/audit.mjs",
    "ci": "pnpm run lint && pnpm run build",
    "clean": "rm -Rf node_modules",
    "fix": "biome check --write",
    "lint": "pnpm run lint:biome && pnpm run lint:tsc",
    "lint:biome": "biome check",
    "lint:tsc": "tsc --noEmit",
    "audit:diff": "node scripts/audit-diff.mjs"
  },
  "browserslist": [
    "baseline 2022",
    "not dead"
  ],
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pg_textsearch": "^0.0.10",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.53.0",
    "mdast-util-mark": "^1.0.0",
    "mermaid": "^12.1.0",
    "micromark-extension-mark": "^1.0.2",
    "ol": "^10.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-deflist": "^1.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "chrome-launcher": "^1.2.2",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.6.0",
    "sharp": "~0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@12.5.1"
}
